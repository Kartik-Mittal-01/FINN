# --- FINN backend configuration (all optional; defaults work with zero setup) ---
DATABASE_URL=sqlite:///./data/finn.db

# Local LLM via Ollama (free). "auto" = use Ollama if it is running, else deterministic fallback.
LLM_PROVIDER=auto            # auto | ollama | none
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Retrieval embeddings. tfidf needs nothing extra. sentence-transformers needs `pip install sentence-transformers`.
EMBEDDINGS_PROVIDER=tfidf    # tfidf | sentence-transformers
ST_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Background refresh (minutes) while in LIVE mode. 0 = disabled.
REFRESH_INTERVAL_MIN=0

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
HTTP_TIMEOUT=20
